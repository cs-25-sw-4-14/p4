struct Point {
    i32 x;
    i32 y;
}

struct Circle {
    Point center;
    f32 radius;
}

struct Rectangle {
    Point top_left;
    Point bottom_right;
    String color;
}

Void main() {
    // Basic variable declarations with different integer types
    triv u8 const_value = 10;      // Now this should work
    mut u16 counter = 0;
    triv mut i32 value = -100;
    u64 large_number = 69420;
    
    // Test all integer types with both positive and negative values
    i8 tiny_signed = -10;
    i16 small_signed = -1000;
    i32 medium_signed = -100000;
    i64 large_signed = -1000000000;
    
    u8 tiny_unsigned = 200;
    u16 small_unsigned = 60000;
    u32 medium_unsigned = 4000000;
    u64 large_unsigned = 9000000000;
    
    // Test floating point types
    f32 float_val = 3.14159;
    f32 float_from_int = 42.0;       // Implicit conversion from int to float
    
    // Test string and bool
    String text = "Hello, world!";
    bool flag = true;
    
    // Test struct initialization with integer literals
    Point p1 = Point {x: 10, y: 20};
    
    // Test with complex expressions
    Point p2 = Point {
        x: 5 + 15,
        y: 10 * 2
    };
    
    // Test with nested struct initialization
    Circle c1 = Circle {
        center: Point {x: 50, y: 50},
        radius: 25.5
    };
    
    Rectangle rect = Rectangle {
        top_left: Point {x: 10, y: 20},
        bottom_right: Point {x: 30, y: 40},
        color: "blue"
    };
    
    // Test with field access
    i32 point_x = p1.x;
    i32 center_y = c1.center.y;
    f32 circle_r = c1.radius;
    
    // Test with complex conditions
    if (counter < 5 && value < 0) {
        counter = counter + 1;
    }
    
    // Test with all arithmetic operations
    i32 sum = p1.x + p2.x;
    i32 diff = p1.y - p2.y;
    i32 prod = p1.x * 2;
    i32 quot = p1.y / 2;
    i32 rem = p1.x % 3;
    
    // Test assignments between different integer types
    counter = 100;     // u16 = i64 (literal)
    counter = sum;     // u16 = i32
    
    // Test boolean operations
    bool is_big = large_number > 1000;
    bool is_valid = (is_big && flag) || (counter > 0);



    /****************************************************
     * SECTION WITH INTENTIONAL TYPE ERRORS
     ****************************************************/
    
    
    u8 a = 15;

    // bool invalid_comp = 42 < true;  // Error: comparing int with bool
    
//    if (42) {                      // Error: condition must be boolean
//        counter = 0;
//    }
}
