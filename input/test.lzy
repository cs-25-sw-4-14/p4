<!-- ----------------------------------- STRUCT DEFINITIONS ----------------------------------- -->

struct Point {
    i32 x;
    i32 y;
}

struct Circle {
    Point center;
    f32 radius;
}

struct Rectangle {
    Point top_left;
    Point bottom_right;
    String color;
}

struct Person {
    String first_name;
    String last_name;
    u8 age;
    bool is_dork;
    Point location;
}

<!-- ------------------------------------- MAIN FUNCTION -------------------------------------- -->

void main() {
    <!-- ----------- VARIABLE DECLARATIONS WITH DIFFERENT TYPES AND MODIFIERS -------------- -->
    
    <!-- Basic types with different modifiers -->
    triv u8 const_value = 10;
    mut u16 counter = 0;              
    triv mut i32 value = -100;        
    u64 large_number = 69420;
    
    <!-- Floating point variables -->
    f32 pi = 3.14159;
    f64 precise_value = 2.7182818284590452353602;
    
    <!-- Boolean variables -->
    bool is_true = true;
    bool is_false = false;
    
    <!-- String variables -->
    String with_text = "Antlr? I barely know her!";
    String empty = "";
    
    <!-- ------------- ARITHMETIC OPERATIONS AND EXPRESSIONS ---------------- -->
    
    <!-- Basic arithmetic -->
    i32 plus = 10 + 20;
    i32 minus = 50 - 30;
    i32 product = 6 * 7;
    i32 division = 100 / 5;
    i32 remainder = 10 % 3;
    
    <!-- Compound arithmetic expressions -->
    i32 complex = (10 + 5) * 2 / (4 - 1);
    
    <!-- Other operations -->
    i32 negated = -value;
    bool inverted = !is_true;
    
    <!-- ------------- CONTROL FLOW STRUCTURES ---------------- -->
    
    <!-- IF STATEMENTS -->
    
    <!-- Basic if statement -->
    if (counter < 5) {
        counter = counter + 1;
    }
    
    <!-- If, else statement -->
    if (value > 0) {
        value = value + 10;
    } else {
        value = 0;
    }
    
    <!-- If, else if, else statement -->
    if (counter > 100) {
        counter = 100;
    } else if (counter > 50) {
        counter = 50;
    } else if (counter > 10) {
        counter = 10;
    } else {
        counter = 0;
    }
    
    <!-- Nested if statements -->
    if (is_true) {
        if (counter > 0) {
            counter = counter - 1;
        }
    }
    
    <!-- WHILE LOOPS -->
    
    <!-- Basic while loop -->
    while (counter < 10) {
        counter = counter + 1;
    }
    
    <!-- While loop with complex condition -->
    while (counter < 20 && value < 0) {
        counter = counter + 1;
        value = value + 10;
    }
    
    <!-- While loop with break -->
    while (counter < 30) {
        counter = counter + 1;
        
        if (counter == 25) {
            break;
        }
    }
    
    <!-- While loop with continue -->
    mut u8 item_count = 0;
    while (item_count < 20) {
        item_count = item_count + 1;
        
        <!-- Skip even numbers using continue -->
        if (item_count % 2 == 0) {
            continue;  <!-- Skip the rest of the iteration -->
        }
        
        <!-- This only executes for odd numbers -->
        i32 odd_value = item_count * 10;
    }
    
    <!-- Nested while loops with break and continue -->
    mut u8 i = 0;
    while (i < 5) {
        i = i + 1;
        mut u8 j = 0;
        
        while (j < 5) {
            j = j + 1;
            
            <!-- Skip specific combinations -->
            if (i == 2 && j == 2) {
                continue;  <!-- Skip this specific iteration -->
            }
            
            counter = counter + 1;
            
            if (j == 3) {
                break;  <!-- Break from inner loop -->
            }
        }
        
        <!-- Skip last iteration of outer loop -->
        if (i == 4) {
            continue;  <!-- Skip the rest of the last iteration -->
        }
    }
    
    <!-- ------------- STRUCTS AND MEMBER ACCESS ---------------- -->
    
    <!-- Creating struct instances -->
    Point origin = Point {x: 0, y: 0};
    Point endpoint = Point {x: 100, y: 100};
    
    <!-- Member access and modification -->
    origin.x = 10;
    endpoint.y = endpoint.y + 50;
    
    <!-- Nested struct creation and access -->
    Circle circle = Circle {
        center: Point {x: 50, y: 50},
        radius: 25.5
    };
    
    <!-- Accessing nested fields -->
    i32 center_x = circle.center.x;
    
    <!-- Modifying nested fields -->
    circle.center.y = 75;
    
    <!-- Person struct -->
    Person person = Person{
        first_name: "Marc",
        last_name: "Nygaard",
        age: 24,
        is_dork: true,
        location: Point {x: 15, y: 25}
    };
    
    <!-- Accessing deeply nested fields -->
    i32 person_x = person.location.x;
    
    <!-- Creating full name from struct fields -->
    String full_name = person.first_name + " " + person.last_name;
    
    <!-- ------------- LOGICAL OPERATIONS ---------------- -->
    
    <!-- Simple logical operations -->
    bool and_result = is_true && !is_false;
    bool or_result = is_true || is_false;
    
    <!-- Complex logical expressions -->
    bool complex_condition = (counter > 10 && value < 0) || (counter == 0);
    
    <!-- ------------- COMPARISON OPERATIONS ---------------- -->
    
    <!-- Basic comparisons -->
    bool is_equal = counter == value;
    bool not_equal = counter != value;
    bool is_greater = counter > value;
    bool is_less = counter < value;
    bool greater_equal = counter >= value;
    bool less_equal = counter <= value;
    
    <!-- Comparing struct fields -->
    bool is_same_x = person.location.x == circle.center.x;
}

<!-- ------------- FUNCTIONS WITH DIFFERENT RETURN TYPES ---------------- -->

<!-- Void function -->
void print_info() {
    <!-- Marc is a dork! -->
}

<!-- Function with parameters and return value -->
i32 add_numbers(i32 first_num, i32 second_num) {
    return first_num + second_num;
}

<!-- Function working with structs -->
f32 calculate_distance(Point p1, Point p2) {
    i32 dx = p2.x - p1.x;
    i32 dy = p2.y - p1.y;
    
    return 0.0;
}

<!-- Function with complex logic -->
bool is_point_in_rectangle(Point p, Rectangle rect) {
    bool x_in_range = p.x >= rect.top_left.x && p.x <= rect.bottom_right.x;
    bool y_in_range = p.y >= rect.top_left.y && p.y <= rect.bottom_right.y;
    
    return x_in_range && y_in_range;
}

<!-- Function demonstrating control flow with continue -->
i32 process_numbers(i32 start, i32 end) {
    i32 sum = 0;
    mut i32 current = start;
    
    while (current <= end) {
        <!-- Skip negative numbers -->
        if (current < 0) {
            current = current + 1;
            continue;
        }
        
        <!-- Skip multiples of 5 -->
        if (current % 5 == 0) {
            current = current + 1;
            continue;
        }
        
        sum = sum + current;
        current = current + 1;
    }
    
    return sum;
}

