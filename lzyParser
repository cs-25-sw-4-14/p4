grammar lzyParser;
options {
    tokenVocab=lzyLex;
}

program:
    (def)+ EOF |
    (stmt)+ EOF;


boolTerm:
    'true' |
    'false'|
    '(' boolExpr ')'|
    ID;

aritTerm:
    type |


    


expr: 

type:
    'u8' |
    'u16' |
    'u32' |
    'u64' |
    'i8' |
    'i16' |
    'i32' |
    'i64' |
    'f8' |
    'f16' |
    'f32' |
    'f64' |
    'bool' |
    'string';

mutability:
    'mut';

importance:
    'triv';



ID: [a-zA-Z][a-zA-Z0-9]*;
STRING: '"' .*? '"';
FLOAT: [0-9]* '.' [0-9]+;
INT: '0' | [1-9] [0-9]*;
WS: [ \t\r\n]+ -> skip;

