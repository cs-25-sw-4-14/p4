use crate::ast::*;

grammar;

pub Program: Program = {
    TopLevelDefinition+ => Program { definitions: <> }
};

TopLevelDefinition: TopLevelDefinition = {
    FunctionDef  => TopLevelDefinition::Function(<>),
    StructDef    => TopLevelDefinition::Struct(<>),
};

FunctionDef: FunctionDef = {
    ReturnOpt ID "(" ParamListOpt ")" "{" Statement* "}" => FunctionDef {
         return_type: __0,
         name: __1,
         params: __3,
         body: __6,
    }
};

ReturnOpt: Option<Type> = {
    Type => Some(__0),
    "Void" => None
};

ParamListOpt: Option<Vec<Param>> = {
    ParamList => Some(__0),
    "" => None
};

ParamList: Vec<Param> = {
    Param ("," Param)* => {
        let mut params = vec![__0];
        params.extend(__1.into_iter().map(|x| x.1));
        params
    }
};

Param: Param = {
    Type ID => Param {
        var_type: __0,
        name: __1,
    }
};

StructDef: StructDef = {
    "Struct" ID "{" StructField* "}" => StructDef {
        name: __1,
        fields: __3,
    }
};

StructField: StructField = {
    Type ID => StructField {
        var_type: __0,
        name: __1,
    }
};

Statement: Statement = {
    VariableDeclaration => Statement::VariableDeclaration(__0),
    Assignment => Statement::Assignment(__0),
    If => Statement::If(__0),
    While => Statement::While(__0),
    Break => Statement::Break,
    Continue => Statement::Continue,
    Return => Statement::Return(__0),
    FunctionCall => Statement::FunctionCall(__0),
};

VariableDeclaration: VariableDeclaration = {
    TrivialOpt MutableOpt Type ID "=" Expression => VariableDeclaration {
        trivial: __0,
        mutable: __1,
        var_type: __2,
        name: __3,
        value: __4,
    }
};

TrivialOpt: bool = {
    "Triv" => true,
    "" => false,
};

MutableOpt: bool = {
    "Mut" => true,
    "" => false,
};

Assignment: Assignment = {
    ID "=" Expression => Assignment {
        target: __0,
        value: __2,
    }
};

If: IfStatement = {
    "if" "(" Expression ")" "{" Statement* "}" ElseIf* Else? => If {
        condition: __2,
        then_branch: __4,
        else_if_branches: __5,
        else_branch: __6,
    }
};

ElseIf: ElseIf = {
    "else" "if" "(" Expression ")" "{" Statement* "}" => ElseIf {
        condition: __2,
        body: __4,
    }
};

Else: Option<Else> = {
    "Else" "{" Statement* "}" => Some(Else { body: __2 }),
    "" => None
};

While: WhileStatement = {
    "while" "(" Expression ")" "{" Statement* "}" => While {
        condition: __2,
        body: __4,
    }
};

Break: Break = {
    "break" => Break,
};

Continue: Continue = {
    "continue" => Continue,
};

Return: Return = {
    "return" Expression? => Return(__1),
};

FunctionCall: FunctionCall = {
    ID "(" ArgumentList? ")" => FunctionCall {
        name: __0,
        args: __2,
    }
};

ArgumentList: Vec<Expression> = {
    Expression ("," Expression)* => {
        let mut args = vec![__0];
        args.extend(__1.into_iter().map(|x| x.1));
        args
    }
};

Expression: Expression = {
    #[precedence(level="0")]
    Term,
    #[precedence(level="1")]
    Literal => Expression::Literal(__0),
    Variable => Expression::Variable(__0),
    BinaryOp => Expression::BinaryOp(__0),
    UnaryOp => Expression::UnaryOp(__0),
    FunctionCall => Expression::FunctionCall(__0),
    StructInit => Expression::StructInit(__0),
    StructFieldAccess => Expression::StructFieldAccess(__0),
    ArrayInit => Expression::ArrayInit(__0),
    ArrayAccess => Expression::ArrayAccess(__0),
    VectorInit => Expression::VectorInit(__0),
    TypeCast => Expression::TypeCast(__0),
};

Term: Expression = {
    "(" <e:Expression> ")" => e,
};

Literal: Literal = {
    StringLiteral => Literal::String(__0),
    IntLiteral => Literal::Int(__0),
    FloatLiteral => Literal::Float(__0),
    CharLiteral => Literal::Char(__0),
    BoolLiteral => Literal::Bool(__0),
};

Variable: Variable = {
    ID => Variable { name: __0 },
};

BinaryOp: BinaryOp = {
    #[precedence(level="0")]
    Expression "/" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::Divide,
        right: Box::new(__2),
    }, 
    Expression "*" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::Multiply,
        right: Box::new(__2),
    },
    Expression "%" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::Modulus,
        right: Box::new(__2),
    },
    #[precedence(level="1")] #[assoc(side="left")]
    Expression "+" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::Add,
        right: Box::new(__2),
    },
    Expression "-" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::Subtract,
        right: Box::new(__2),
    },
    #[precedence(level="2")]
    Expression "<" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::LessThan,
        right: Box::new(__2),
    },
    Expression ">" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::GreaterThan,
        right: Box::new(__2),
    },
    Expression "<=" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::LessThanOrEqual,
        right: Box::new(__2),
    },
    Expression ">=" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::GreaterThanOrEqual,
        right: Box::new(__2),
    },
    #[precedence(level="3")]
    Expression "==" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::Equal,
        right: Box::new(__2),
    },
    Expression "!=" Expression => BinaryExpression {
        right: Box::new(__o),
        operator: BinaryOperator::NotEqual,
        right: Box::new(__2),
    },
    Expression "&&" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::And,
        right: Box::new(__2),
    },
    Expression "||" Expression => BinaryExpression {
        left: Box::new(__0),
        operator: BinaryOperator::And,
        right: Box::new(__2),
    },
};

UnaryOp: UnaryOp = {
    "-" <e:Expression> => UnaryExpression {
        operator: UnaryOperator::Negate,
        operand: Box::new(e),
    },
    "!" <e:Expression> => UnaryExpression {
        operator: UnaryOperator::Not,
        operand: Box::new(e),
    },
};

StructInit: StructInit = {
    ID "{" StructField* "}" => StructInit {
        name: __0,
        fields: __2,
    }
};

StructFieldAccess: StructFieldAccess = {
    ID "." ID => StructFieldAccess {
        struct_name: __0,
        field_name: __2,
    }
};

ArrayInit: ArrayInit = {
    "[" Expression ("," Expression)* "]" => ArrayInit {
        elements: {
            let mut elements = vec![__1];
            elements.extend(__2.into_iter().map(|x| x.1));
            elements
        },
    }
};

ArrayAccess: ArrayAccess = {
    ID "[" Expression "]" => ArrayAccess {
        array_name: __0,
        index: __2,
    }
};

VectorInit: VectorInit = {
    "Vec" "<" Type ">" "[" Expression ("," Expression)* "]" => VectorInit {
        var_type: __1,
        elements: {
            let mut elements = vec![__4];
            elements.extend(__5.into_iter().map(|x| x.1));
            elements
        },
    }
};

TypeCast: TypeCast = {
    Expression "as" Type => TypeCast {
        expression: __1,
        target_type: __3,
    }
};

// Type - all possible data types in the language
Type: Type = {
    "u8" => Type::U8,
    "u16" => Type::U16,
    "u32" => Type::U32,
    "u64" => Type::U64,
    "i8" => Type::I8,
    "i16" => Type::I16,
    "i32" => Type::I32,
    "i64" => Type::I64,
    "f8" => Type::F8,
    "f16" => Type::F16,
    "f32" => Type::F32,
    "f64" => Type::F64,
    "bool" => Type::Bool,
    "String" => Type::String,
    "Vec" "<" Type ">" => Type::Vector(__2),
    "Array" Type "[" IntLiteral "]"=> Type::Array(__1, __3),
};


// String literals with escape support (e.g., "hello\nworld")
StringLiteral: String = {
    r#""([^"\\\r\n]|\\.)*""# => |s| {
        let inner = &s[1..s.len()-1]; // Strip surrounding quotes
        unescape_str(inner)
    }
};

// Integer literals (e.g., 0, 42)
IntLiteral: i64 = {
    r"0|[1-9][0-9]*" => |s| s.parse().unwrap()
};

// Floating-point literals (e.g., 3.14, 0.001)
FloatLiteral: f64 = {
    r"[0-9]+\.[0-9]+" => |s| s.parse().unwrap()
};

// Character literals with escape support (e.g., 'a', '\n')
CharLiteral: char = {
    r#"'([^'\\\r\n]|\\.)'"# => |s| {
        let inner = &s[1..s.len()-1]; // Strip surrounding quotes
        unescape_char(inner)
    }
};

// Boolean literals (true / false)
BoolLiteral: bool = {
    "true" => |_| true,
    "false" => |_| false,
};

// Identifiers (variable and function names)
ID: String = {
    r"[a-zA-Z_][a-zA-Z0-9_]*" => |s| s.to_string()
};
