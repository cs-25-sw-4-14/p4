use crate::ast::*;

grammar;

match {
    r"\s*" => { }, // Skip whitespace
    r"//[^\n\r]*[\n\r]*" => { }, // Skip line comments
    r"/\*([^*]|[\r\n]|(\*+([^*/]|[\r\n])))*\*+/" => { }, // Skip block comments
    _
}

pub Program: Program = {
    TopLevelDefinition+ => Program { definitions: <> }
};

pub TopLevelDefinition: TopLevelDefinition = {
    FunctionDef  => TopLevelDefinition::Function(<>),
    StructDef    => TopLevelDefinition::Struct(<>),
};


pub FunctionDef: FunctionDef = {
    <r:ReturnOpt> <n:ID> "(" <p:ParamList?> ")" "{" <b:Statement*> "}" => FunctionDef {
         return_type: r,
         name: n,
         params: p.unwrap_or(vec![]),
         body: b,
    }
};

pub ReturnOpt: Option<Type> = {
    <t:Type> => Some(t),
    "void" => None
};

pub ParamList: Vec<Param> = {
    <p:Param> <pn:("," Param)*> => {
        let mut params = vec![p];
        params.extend(pn.into_iter().map(|x| x.1));
        params
    }
};

pub Param: Param = {
    <t:Type> <n:ID> => Param {
        param_type: t,
        name: n,
    }
};

pub StructDef: StructDef = {
    "struct" <n:ID> "{" <f:StructField*> "}" => StructDef {
        name: n,
        fields: f,
    }
};

pub StructField: StructField = {
    <t:Type> <n:ID> ";" => StructField {
        field_type: t,
        name: n,
    }
};

pub Statement: Statement = {
    <l:@L> <t:Throwaway> => Statement::Throwaway(t, l),
    <l:@L> <t:VariableDeclaration> => Statement::VariableDeclaration(t, l),
    <l:@L> <t:Assignment> => Statement::Assignment(t, l),
    <l:@L> <t:If> => Statement::If(t, l),
    <l:@L> <t:While> => Statement::While(t, l),
    <l:@L> "break" ";" => Statement::Break(l),
    <l:@L> "continue" ";" => Statement::Continue(l),
    <l:@L> <t:Return> => Statement::Return(t, l),
    <l:@L> <t:Debug> => Statement::Debug(t, l),
    <l:@L> <t:Write> => Statement::Write(t, l),
    <l:@L> <t:FunctionCall> ";" => Statement::FunctionCall(t, l),
};

pub Throwaway: Throwaway = {
    "_" "=" <e:Expression> ";" => Throwaway {
        expression: e,
    }
};

pub VariableDeclaration: VariableDeclaration = {
    <tr:Trivial?> <mu:Mutable?> <t:Type> <n:ID> "=" <v:Expression> ";" => VariableDeclaration {
        trivial: tr,
        mutable: mu,
        var_type: t,
        name: n,
        value: v,
    }
};

pub Trivial: () = {
    "triv" => (),
};

pub Mutable: () = {
    "mut" => (),
};

pub Assignment: Assignment = {
    <t:Expression> "=" <v:Expression> ";" => Assignment {
        target: t,
        value: v,
    }
};

ElseIf: ElseIf = {
    "else if" "(" <c:Expression> ")" "{" <b:Statement*> "}" => ElseIf {
        condition: c,
        body: b,
    }
};

pub If: IfStatement = {
    "if" "(" <c:Expression> ")" "{" <t:Statement*> "}" <ei:ElseIf*> <e:Else?> => IfStatement {
        condition: c,
        then_block: t,
        else_if_blocks: ei,
        else_block: e,
    }
};

pub Else: Vec<Statement> = {
    "else" "{" <b:Statement*> "}" => b,
};

pub While: WhileStatement = {
    "while" "(" <c:Expression> ")" "{" <b:Statement*> "}" => WhileStatement {
        condition: c,
        body: b,
    }
};

pub Return: ReturnStatement = {
    "return" <e:Expression> ";" => ReturnStatement { value: Some(e) },
    "return" ";" => ReturnStatement { value: None },
};

pub Debug: Debug = {
    "debug" "(" <e:Expression> ")" ";" => Debug {
        expression: e,
    }
};

pub Write: Write = {
    "write" "(" <e:Expression> ")" ";" => Write {
        value: e,
    }
};

pub Read: Read = {
    "read" "(" <e:Expression> ")" ";" => Read {
        value: e,
    }
};


pub FunctionCall: FunctionCall = {
    <n:ID> "(" <a:ArgumentList?> ")"=> FunctionCall {
        name: n,
        args: a.unwrap_or(vec![]),
    }
};

pub ArgumentList: Vec<Expression> = {
    <e:Expression> <en:("," Expression)*> => {
        let mut args = vec![e];
        args.extend(en.into_iter().map(|x| x.1));
        args
    }
};

pub Term: Expression = {
    "(" <e:Expression> ")" => e,
    <e:Literal> => Expression::Literal(e),
    <e:ID> => Expression::Variable(e),
    <e:Read> => Expression::Read(Box::new(e)),
    <e:FunctionCall> => Expression::FunctionCall(e),
    <e:StructInit> => Expression::StructInit(e),
    <e:ArrayLiteral> => Expression::ArrayLiteral(Box::new(e)),
    <e:ArrayAccess> => Expression::ArrayAccess(Box::new(e)),
    "&" <e:Term> => Expression::Reference(Box::new(e), false),
    "&mut" <e:Term> => Expression::Reference(Box::new(e), true),
    "*" <e:Term> => Expression::Dereference(Box::new(e)),
};

pub Expression: Expression = {
    #[precedence(level="0")]
    Term,
    #[precedence(level="1")]
    <e:Expression> "as" <t:Type> => Expression::TypeCast(TypeCast {
        target_type: t,
        expression: Box::new(e),
    }),
    #[precedence(level="2")] #[assoc(side="right")]
    "-" <o:Expression> => Expression::UnaryOp(UnaryOperation {
        operator: UnaryOperator::Negate,
        operand: Box::new(o),
    }),
    #[precedence(level="3")] #[assoc(side="right")]
    "!" <o:Expression> => Expression::UnaryOp(UnaryOperation {
        operator: UnaryOperator::Not,
        operand: Box::new(o),
    }),
    // TODO: Fix struct field access so it is recursive
    #[precedence(level="4")] #[assoc(side="left")]
    <e:Expression> "." <f:ID> => Expression::StructFieldAccess(StructFieldAccess {
        struct_expr: Box::new(e),
        field_name: f,
    }),
        
    #[precedence(level="5")] #[assoc(side="left")]
    <l:Expression> "/" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Divide,
        right: Box::new(r),
    }), 
    #[precedence(level="6")] #[assoc(side="left")]
    <l:Expression> "*" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Multiply,
        right: Box::new(r),
    }),
    #[precedence(level="7")] #[assoc(side="left")]
    <l:Expression> "%" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Modulus,
        right: Box::new(r),
    }),
    #[precedence(level="8")] #[assoc(side="left")]
    <l:Expression> "+" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Add,
        right: Box::new(r),
    }),
    #[precedence(level="9")] #[assoc(side="left")]
    <l:Expression> "-" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Subtract,
        right: Box::new(r),
    }),
    #[precedence(level="10")] #[assoc(side="left")]
    <l:Expression> "<" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::LessThan,
        right: Box::new(r),
    }),
    #[precedence(level="11")] #[assoc(side="left")]
    <l:Expression> ">" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::GreaterThan,
        right: Box::new(r),
    }),
    #[precedence(level="12")] #[assoc(side="left")]
    <l:Expression> "<=" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::LessThanOrEqual,
        right: Box::new(r),
    }),
    #[precedence(level="13")] #[assoc(side="left")]
    <l:Expression> ">=" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::GreaterThanOrEqual,
        right: Box::new(r),
    }),
    #[precedence(level="14")] #[assoc(side="left")]
    <l:Expression> "==" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Equal,
        right: Box::new(r),
    }),
    #[precedence(level="15")] #[assoc(side="left")]
    <l:Expression> "!=" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::NotEqual,
        right: Box::new(r),
    }),
    #[precedence(level="16")] #[assoc(side="left")]
    <l:Expression> "&&" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::And,
        right: Box::new(r),
    }),
    #[precedence(level="17")] #[assoc(side="left")]
    <l:Expression> "||" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Or,
        right: Box::new(r),
    }),
        };

pub ArrayLiteral: ArrayLiteral = {
    "[" <e:Expression> <en:("," Expression)*> "]" => ArrayLiteral {
        elements: {
            let mut elements = vec![e];
            elements.extend(en.into_iter().map(|x| x.1));
            elements
        },
    }
};

pub Literal: Literal = {
    <l:StringLiteral> => Literal::String(l),
    <l:IntLiteral> => Literal::Int(l),
    <l:FloatLiteral> => Literal::Float(l),
    <l:CharLiteral> => Literal::Char(l),
    <l:BoolLiteral> => Literal::Bool(l),
};

pub StructInit: StructInit = {
    <n:ID> "{" <f:StructFieldInit*> "}" => StructInit {
        name: n,
        fields: f,
    }
};

pub StructFieldInit: StructFieldInit = {
    <n:ID> ":" <v:Expression> ","? => StructFieldInit {
        name: n,
        value: v,
    }
};

pub ArrayAccess: ArrayAccess = {
    <n:ID> "[" <i:Expression> "]" => ArrayAccess {
        array_name: n,
        index: i,
    }
};

// Type - all possible data types in the language
pub Type: Type = {
    "u8" => Type::U8,
    "u16" => Type::U16,
    "u32" => Type::U32,
    "u64" => Type::U64,
    "i8" => Type::I8,
    "i16" => Type::I16,
    "i32" => Type::I32,
    "i64" => Type::I64,
    "f16" => Type::FP16,
    "f32" => Type::FP32,
    "f64" => Type::FP64,
    "String" => Type::String,
    "char" => Type::Char,
    "bool" => Type::Bool,
    "Vec" "<" <t:Type> ">" => Type::Vector(Box::new(t)),
    "arr" <t:Type> "[" <l:IntLiteral> "]"=> Type::Array(Box::new(t), l),
    <i:ID> => Type::Struct(i.to_string()),
    "&" <t:Type> => Type::Reference(Box::new(t), false),
    "&mut" <t:Type> => Type::Reference(Box::new(t), true),
};


// String literals with escape support (e.g., "hello\nworld")
pub StringLiteral: String = {
    <s:r#""([^"\\\r\n]|\\.)*""#> => s[1..s.len() - 1].to_string()
};

// Integer literals (e.g., 0, 42)
pub IntLiteral: u64 = {
    <s:r"0|[1-9][0-9]*"> => s.parse().unwrap()
};

// Floating-point literals (e.g., 3.14, 0.001)
pub FloatLiteral: f64 = {
    <s:r"[0-9]+\.[0-9]+"> => s.parse().unwrap()
};

// Character literals with escape support (e.g., 'a', '\n')
pub CharLiteral: char = {
    <s:r#"'([^'\\\r\n]|\\.)'"#> => s.chars().nth(1).unwrap()
};

// Boolean literals (true / false)
pub BoolLiteral: bool = {
    "true" => true,
    "false" => false,
};


// Identifiers (variable and function names)
pub ID: String = {
    <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => match s {
        "write" | "read" | "debug" => panic!("Reserved keyword used as identifier: {}", s),
        _ => s.to_string(),
    }

};
