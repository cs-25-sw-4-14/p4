use crate::ast::*;
use crate::tokens::{Token, LexicalError};

grammar;

extern {
  type Location = usize;
  type Error = LexicalError;

  enum Token {
    "mut" => Token::KeywordMut,
    "triv" => Token::KeywordTrivial,
    "&mut" => Token::KeywordRefMut,
    "&" => Token::KeywordRef,
    "arr" => Token::TypeArray,
    "Vec" => Token::TypeVector,
    "bool" => Token::TypeBool,
    "char" => Token::TypeChar,
    "String" => Token::TypeString,
    "f64" => Token::TypeF64,
    "f32" => Token::TypeF32,
    "f16" => Token::TypeF16,
    "i64" => Token::TypeI64,
    "i32" => Token::TypeI32,
    "i16" => Token::TypeI16,
    "i8" => Token::TypeI8,
    "u64" => Token::TypeU64,
    "u32" => Token::TypeU32,
    "u16" => Token::TypeU16,
    "u8" => Token::TypeU8,
    "(" => Token::LParen,
    ")" => Token::RParen,
    "[" => Token::LBracket,
    "]" => Token::RBracket,
    "{" => Token::LBrace,
    "}" => Token::RBrace,
    "," => Token::Comma,
    ";" => Token::Semicolon,
    ":" => Token::Colon,
    "||" => Token::OperatorOr,
    "&&" => Token::OperatorAnd,
    "!=" => Token::OperatorNotEqual,
    "==" => Token::OperatorEqual,
    ">=" => Token::OperatorGreaterEqual,
    "<=" => Token::OperatorLessEqual,
    ">" => Token::OperatorGreater,
    "<" => Token::OperatorLess,
    "+" => Token::OperatorAdd,
    "%" => Token::OperatorMod,
    "*" => Token::Star,
    "/" => Token::OperatorDiv,
    "." => Token::Dot,
    "!" => Token::OperatorNot,
    "-" => Token::OperatorNeg,
    "as" => Token::OperatorAs,
    "read_file" => Token::KeywordRead,
    "write_file" => Token::KeywordWrite,
    ".insert" => Token::MethodInsert,
    ".remove" => Token::MethodRemove,
    ".get" => Token::MethodGet,
    "debug" => Token::KeywordDebug,
    "return" => Token::KeywordReturn,
    "while" => Token::KeywordWhile,
    "if" => Token::KeywordIf,
    "else" => Token::KeywordElse,
    "=" => Token::Assign,
    "struct" => Token::KeywordStruct,
    "void" => Token::KeywordVoid,
    "break" => Token::KeywordBreak,
    "continue" => Token::KeywordContinue,
    "_" => Token::Throwaway,
    Identifier => Token::Identifier(<String>),
    IntLiteral => Token::IntLiteral(<u64>),
    StringLiteral => Token::StringLiteral(<String>),
    BoolLiteral => Token::BoolLiteral(<bool>),
    FloatLiteral => Token::FloatLiteral(<f64>),
    CharLiteral => Token::CharLiteral(<char>),
  }
}

pub Program: Program = {
    TopLevelDefinition+ => Program { definitions: <> }
};

pub TopLevelDefinition: TopLevelDefinition = {
    FunctionDef  => TopLevelDefinition::Function(<>),
    StructDef    => TopLevelDefinition::Struct(<>),
};

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};

pub FunctionDef: FunctionDef = {
    <t:ReturnOpt> <n:Identifier> "(" <p:Comma<Param>> ")" "{" <b:Statement*> "}" => FunctionDef {
         return_type: t,
         name: n,
         params: p,
         body: b,
    }
};

pub ReturnOpt: Option<Type> = {
    <t:Type> => Some(t),
    "void" => None
};

pub Param: Param = {
    <t:Type> <n:Identifier> => Param {
        param_type: t,
        name: n,
    }
};

pub StructDef: StructDef = {
    "struct" <n:Identifier> "{" <f:StructField*> "}" => StructDef {
        name: n,
        fields: f,
    }
};

pub StructField: StructField = {
    <t:Type> <n:Identifier> ";" => StructField {
        field_type: t,
        name: n,
    }
};

pub Statement: Statement = {
    <l:@L> <t:Throwaway> ";"=> Statement::Throwaway(t, l),
    <l:@L> <t:VariableDeclaration> ";" => Statement::VariableDeclaration(t, l),
    <l:@L> <t:Assignment> ";" => Statement::Assignment(t, l),
    <l:@L> <t:VectorInsert> ";" => Statement::VectorInsert(t, l),
    <l:@L> <t:VectorRemove> ";" => Statement::VectorRemove(t, l),
    <l:@L> <t:If> => Statement::If(t, l),
    <l:@L> <t:While> => Statement::While(t, l),
    <l:@L> "break" ";" => Statement::Break(l),
    <l:@L> "continue" ";" => Statement::Continue(l),
    <l:@L> <t:Return> ";" => Statement::Return(t, l),
    <l:@L> <t:Debug> ";" => Statement::Debug(t, l),
    <l:@L> <t:FunctionCall> ";" => Statement::FunctionCall(t, l),
};

pub Throwaway: Throwaway = {
    "_" "=" <e:Expression> => Throwaway {
        expression: e,
    }
};

pub VariableDeclaration: VariableDeclaration = {
    <tr:Trivial?> <mu:Mutable?> <t:Type> <n:Identifier> "=" <v:Expression> => VariableDeclaration {
        trivial: tr,
        mutable: mu,
        var_type: t,
        name: n,
        value: v,
    }
};

pub Trivial: () = {
    "triv" => (),
};

pub Mutable: () = {
    "mut" => (),
};

pub Assignment: Assignment = {
    <t:Expression> "=" <v:Expression> => Assignment {
        target: t,
        value: v,
    }
};
pub VectorInsert: VectorInsert = {
    <n:Identifier> ".insert" "(" <i:Expression> "," <v:Expression> ")" => VectorInsert {
        vector_name: n,
        index: i,
        value: v,
    }
};
pub VectorRemove: VectorRemove = {
    <n:Identifier> ".remove" "(" <i:Expression> ")" => VectorRemove {
        vector_name: n,
        index: i,
    }
};

ElseIf: ElseIf = {
    "else" "if" "(" <c:Expression> ")" "{" <b:Statement*> "}" => ElseIf {
        condition: c,
        body: b,
    }
};

pub If: IfStatement = {
    "if" "(" <c:Expression> ")" "{" <t:Statement*> "}" <ei:ElseIf*> <e:Else?> => IfStatement {
        condition: c,
        then_block: t,
        else_if_blocks: ei,
        else_block: e,
    }
};

pub Else: Vec<Statement> = {
    "else" "{" <b:Statement*> "}" => b,
};

pub While: WhileStatement = {
    "while" "(" <c:Expression> ")" "{" <b:Statement*> "}" => WhileStatement {
        condition: c,
        body: b,
    }
};

pub Return: ReturnStatement = {
    "return" <e:Expression> => ReturnStatement { value: Some(e) },
    "return" => ReturnStatement { value: None },
};

pub Debug: Debug = {
    "debug" "(" <e:Expression> ")" => Debug {
        expression: e,
    }
};

pub Write: Write = {
    "write_file" "(" <value:Expression> "," <target:Expression> ")" => Write {
        value,
        target,
    }
};

pub Read: Read = {
    "read_file" "(" <e: Expression> ")" => Read {
        value: e,
    }
};

pub FunctionCall: FunctionCall = {
    <n:Identifier> "(" <a:Comma<Expression>> ")" => FunctionCall {
        name: n,
        args: a,
    }
};

pub Term: Expression = {
    "(" <e:Expression> ")" => e,
    <e:Literal> => Expression::Literal(e),
    <e:Identifier> => Expression::Variable(e),
    <e:Read> => Expression::Read(Box::new(e)),
    <e:Write> => Expression::Write(Box::new(e)),
    <e:FunctionCall> => Expression::FunctionCall(e),
    <e:StructInit> => Expression::StructInit(e),
    <e:ArrayAccess> => Expression::ArrayAccess(Box::new(e)),
    <e:VectorAccess> => Expression::VectorAccess(Box::new(e)),
    <e:ArrayLiteral> => Expression::ArrayLiteral(Box::new(e)),
     <e:VectorLiteral> => Expression::VectorLiteral(Box::new(e)),
    "&" <e:Term> => Expression::Reference(Box::new(e), false),
    "&mut" <e:Term> => Expression::Reference(Box::new(e), true),
    "*" <e:Term> => Expression::Dereference(Box::new(e)),
};

pub Expression: Expression = {
    #[precedence(level="0")]
    Term,
    #[precedence(level="1")]
    <e:Expression> "as" <t:Type> => Expression::TypeCast(TypeCast {
        target_type: t,
        expression: Box::new(e),
    }),
    #[precedence(level="2")] #[assoc(side="right")]
    "-" <o:Expression> => Expression::UnaryOp(UnaryOperation {
        operator: UnaryOperator::Negate,
        operand: Box::new(o),
    }),
    #[precedence(level="3")] #[assoc(side="right")]
    "!" <o:Expression> => Expression::UnaryOp(UnaryOperation {
        operator: UnaryOperator::Not,
        operand: Box::new(o),
    }),
    #[precedence(level="4")] #[assoc(side="left")]
    <e:Expression> "." <f:Identifier> => Expression::StructFieldAccess(StructFieldAccess {
        struct_expr: Box::new(e),
        field_name: f,
    }),
    #[precedence(level="5")] #[assoc(side="left")]
    <l:Expression> "/" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Divide,
        right: Box::new(r),
    }), 
    #[precedence(level="6")] #[assoc(side="left")]
    <l:Expression> "*" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Multiply,
        right: Box::new(r),
    }),
    #[precedence(level="7")] #[assoc(side="left")]
    <l:Expression> "%" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Modulus,
        right: Box::new(r),
    }),
    #[precedence(level="8")] #[assoc(side="left")]
    <l:Expression> "+" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Add,
        right: Box::new(r),
    }),
    #[precedence(level="9")] #[assoc(side="left")]
    <l:Expression> "-" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Subtract,
        right: Box::new(r),
    }),
    #[precedence(level="10")] #[assoc(side="left")]
    <l:Expression> "<" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::LessThan,
        right: Box::new(r),
    }),
    #[precedence(level="11")] #[assoc(side="left")]
    <l:Expression> ">" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::GreaterThan,
        right: Box::new(r),
    }),
    #[precedence(level="12")] #[assoc(side="left")]
    <l:Expression> "<=" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::LessThanOrEqual,
        right: Box::new(r),
    }),
    #[precedence(level="13")] #[assoc(side="left")]
    <l:Expression> ">=" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::GreaterThanOrEqual,
        right: Box::new(r),
    }),
    #[precedence(level="14")] #[assoc(side="left")]
    <l:Expression> "==" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Equal,
        right: Box::new(r),
    }),
    #[precedence(level="15")] #[assoc(side="left")]
    <l:Expression> "!=" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::NotEqual,
        right: Box::new(r),
    }),
    #[precedence(level="16")] #[assoc(side="left")]
    <l:Expression> "&&" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::And,
        right: Box::new(r),
    }),
    #[precedence(level="17")] #[assoc(side="left")]
    <l:Expression> "||" <r:Expression> => Expression::BinaryOp(BinaryOperation {
        left: Box::new(l),
        operator: BinaryOperator::Or,
        right: Box::new(r),
    }),
        };

pub VectorLiteral: VectorLiteral = {
    "{" <e:Comma<Expression>> "}" => VectorLiteral {
        elements: e
    }
};

pub ArrayLiteral: ArrayLiteral = {
    "[" <e:Comma<Expression>> "]" => ArrayLiteral {
        elements: e
    },
    "[" <n:IntLiteral> ";" <e:Expression> "]" => {
      ArrayLiteral {
        elements: std::iter::repeat(e.clone())
        .take(n as usize)
        .collect::<Vec<Expression>>()
      }
    }
};

pub Literal: Literal = {
    <l:StringLiteral> => Literal::String(l),
    <l:IntLiteral> => Literal::Int(l),
    <l:FloatLiteral> => Literal::Float(l),
    <l:CharLiteral> => Literal::Char(l),
    <l:BoolLiteral> => Literal::Bool(l),
};

pub StructInit: StructInit = {
    <n:Identifier> "{" <f:Comma<StructFieldInit>> "}" => StructInit {
        name: n,
        fields: f,
    }
};

pub StructFieldInit: StructFieldInit = {
    <n:Identifier> ":" <v:Expression> => StructFieldInit {
        name: n,
        value: v,
    }
};

pub ArrayAccess: ArrayAccess = {
    <n:Identifier> "[" <i:Expression> "]" => ArrayAccess {
        array_name: n,
        index: i,
    }
};

pub VectorAccess: VectorAccess = {
    <n:Identifier> ".get" "(" <i:Expression> ")" => VectorAccess {
        vector_name: n,
        index: i,
    }
};


// Type - all possible data types in the language
pub Type: Type = {
    "u8" => Type::U8,
    "u16" => Type::U16,
    "u32" => Type::U32,
    "u64" => Type::U64,
    "i8" => Type::I8,
    "i16" => Type::I16,
    "i32" => Type::I32,
    "i64" => Type::I64,
    "f16" => Type::F16,
    "f32" => Type::F32,
    "f64" => Type::F64,
    "String" => Type::String,
    "char" => Type::Char,
    "bool" => Type::Bool,
    "Vec" "<" <t:Type> ">" => Type::Vector(Box::new(t)),
    "arr" <t:Type> "[" <l:IntLiteral> "]"=> Type::Array(Box::new(t), l),
    <i:Identifier> => Type::Struct(i.to_string()),
    "&" <t:Type> => Type::Reference(Box::new(t), false),
    "&mut" <t:Type> => Type::Reference(Box::new(t), true),
};
