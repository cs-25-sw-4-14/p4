use crate::ast::*;

grammar;

pub Program: Program = {
    TopLevelDefinition+ => Program { definitions: <> }
};

TopLevelDefinition: TopLevelDefinition = {
    FunctionDef  => TopLevelDefinition::Function(<>),
    StructDef    => TopLevelDefinition::Struct(<>),
};

FunctionDef: FunctionDef = {
    <r:ReturnOpt> <n:ID> "(" <p:ParamListOpt> ")" "{" <b:Statement*> "}" => FunctionDef {
         return_type: r,
         name: n,
         params: p,
         body: b,
    }
};

ReturnOpt: Option<Type> = {
    <t:Type> => Some(t),
    "Void" => None
};

ParamListOpt: Option<Vec<Param>> = {
    <p:ParamList> => Some(p),
    "" => None
};

ParamList: Vec<Param> = {
    <p:Param> <pn:("," Param)*> => {
        let mut params = vec![p];
        params.extend(__1.into_iter().map(|x| x.1));
        params
    }
};

Param: Param = {
    <t:Type> <n:ID> => Param {
        var_type: t,
        name: n,
    }
};

StructDef: StructDef = {
    "Struct" <n:ID> "{" <f:StructField*> "}" => StructDef {
        name: n,
        fields: f,
    }
};

StructField: StructField = {
    <t:Type> <n:ID> => StructField {
        var_type: t,
        name: n,
    }
};

StructFieldInit: StructFieldInit = {
    <n:ID> ":" <v:Expression> => StructFieldInit {
        field_name: n,
        value: v,
    }
};

Statement: Statement = {
    <t:VariableDeclaration> => Statement::VariableDeclaration(t),
    <t:Assignment> => Statement::Assignment(t),
    <t:If> => Statement::If(t),
    <t:While> => Statement::While(t),
    Break => Statement::Break,
    Continue => Statement::Continue,
    <t:Return> => Statement::Return(t),
    <t:FunctionCall> => Statement::FunctionCall(t),
};

VariableDeclaration: VariableDeclaration = {
    <tr:TrivialOpt> <mu:MutableOpt> <t:Type> <n:ID> "=" <v:Expression> ";" => VariableDeclaration {
        trivial: tr,
        mutable: mu,
        var_type: t,
        name: n,
        value: v,
    }
};

TrivialOpt: bool = {
    "Triv" => true,
    "" => false,
};

MutableOpt: bool = {
    "Mut" => true,
    "" => false,
};

Assignment: Assignment = {
    <t:ID> "=" <v:Expression> ";" => Assignment {
        target: t,
        value: v,
    }
};

If: IfStatement = {
    "if" "(" <c:Expression> ")" "{" <t:Statement*> "}" <ei:ElseIf*> <e:("Else" "{" Statement* "}")?> => If {
        condition: c,
        then_branch: t,
        else_if_branches: ei,
        else_branch: e,
    }
};

ElseIf: ElseIf = {
    "else" "if" "(" <c:Expression> ")" "{" <b:Statement*> "}" => ElseIf {
        condition: c,
        body: b,
    }
};

While: WhileStatement = {
    "while" "(" <c:Expression> ")" "{" <b:Statement*> "}" => While {
        condition: c,
        body: b,
    }
};

Break: Break = {
    "break" ";" => Break,
};

Continue: Continue = {
    "continue" ";" => Continue,
};

Return: ReturnStatement = {
    "return" <e:Expression> ";" => ReturnStatement { value: Some(e) },
    "return" ";" => ReturnStatement { value: None },
};

FunctionCall: FunctionCall = {
    <n:ID> "(" <a:ArgumentList?> ")" ";"=> FunctionCall {
        name: n,
        args: a,
    }
};

ArgumentList: Vec<Expression> = {
    <e:Expression> <en:("," Expression)*> => {
        let mut args = vec![e];
        args.extend(en.into_iter().map(|x| x.1));
        args
    }
};

Expression: Expression = {
    #[precedence(level="0")]
    Term,

    #[precedence(level="1")] #[assoc(side="left")]
    "-" <o:Expression> => Expression::UnaryOp(UnaryExpression {
        operator: UnaryOperator::Negate,
        operand: Box::new(o),
    }),
    "!" <o:Expression> => Expression::UnaryOp(UnaryExpression {
        operator: UnaryOperator::Not,
        operand: Box::new(o),
    }),

    #[precedence(level="2")] #[assoc(side="left")]
    <l:Expression> "/" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::Divide,
        right: Box::new(r),
    }), 
    <l:Expression> "*" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::Multiply,
        right: Box::new(r),
    }),
    <l:Expression> "%" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::Modulus,
        right: Box::new(r),
    }),
    #[precedence(level="3")] #[assoc(side="left")]
    <l:Expression> "+" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::Add,
        right: Box::new(r),
    }),
    <l:Expression> "-" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::Subtract,
        right: Box::new(r),
    }),
    #[precedence(level="4")] #[assoc(side="left")]
    <l:Expression> "<" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::LessThan,
        right: Box::new(r),
    }),
    <l:Expression> ">" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::GreaterThan,
        right: Box::new(r),
    }),
    <l:Expression> "<=" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::LessThanOrEqual,
        right: Box::new(r),
    }),
    <l:Expression> ">=" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::GreaterThanOrEqual,
        right: Box::new(r),
    }),
    #[precedence(level="5")] #[assoc(side="left")]
    <l:Expression> "==" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::Equal,
        right: Box::new(r),
    }),
    <l:Expression> "!=" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        right: Box::new(__o),
        operator: BinaryOperator::NotEqual,
        right: Box::new(r),
    }),
    <l:Expression> "&&" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::And,
        right: Box::new(r),
    }),
    <l:Expression> "||" <r:Expression> => Expression::BinaryOp(BinaryExpression {
        left: Box::new(l),
        operator: BinaryOperator::And,
        right: Box::new(r),
    }),
    <e:Literal> => Expression::Literal(e),
    <e:Variable> => Expression::Variable(e),
    <e:FunctionCall> => Expression::FunctionCall(e),
    <e:StructInit> => Expression::StructInit(e),
    <e:StructFieldAccess> => Expression::StructFieldAccess(e),
    <e:ArrayInit> => Expression::ArrayInit(e),
    <e:ArrayAccess> => Expression::ArrayAccess(e),
    <e:VectorInit> => Expression::VectorInit(e),
    <e:TypeCast> => Expression::TypeCast(e),
};

Term: Expression = {
    "(" <e:Expression> ")" => e,
};

Literal: Literal = {
    <l:StringLiteral> => Literal::String(l),
    <l:IntLiteral> => Literal::Int(l),
    <l:FloatLiteral> => Literal::Float(l),
    <l:CharLiteral> => Literal::Char(l),
    <l:BoolLiteral> => Literal::Bool(l),
};

Variable: Variable = {
    <n:ID> => Variable { name:n },
};

StructInit: StructInit = {
    <n:ID> "{" <f:StructFieldInit*> "}" => StructInit {
        name: n,
        fields: f,
    }
};

StructFieldAccess: StructFieldAccess = {
    <sn:ID> "." <fn:ID> => StructFieldAccess {
        struct_name: sn,
        field_name: fn,
    }
};

ArrayInit: ArrayInit = {
    "[" <e:Expression> <en:("," Expression)*> "]" => ArrayInit {
        elements: {
            let mut elements = vec![e];
            elements.extend(en.into_iter().map(|x| x.1));
            elements
        },
    }
};

ArrayAccess: ArrayAccess = {
    <n:ID> "[" <i:Expression> "]" => ArrayAccess {
        array_name: n,
        index: i,
    }
};

VectorInit: VectorInit = {
    "Vec" "<" <t:Type> ">" "[" <e:Expression> <en:("," Expression)*> "]" => VectorInit {
        var_type: t,
        elements: {
            let mut elements = vec![e];
            elements.extend(en.into_iter().map(|x| x.1));
            elements
        },
    }
};

TypeCast: TypeCast = {
    <e:Expression> "as" <t:Type> => TypeCast {
        expression: e,
        target_type: t,
    }
};

// Type - all possible data types in the language
Type: Type = {
    "u8" => Type::U8,
    "u16" => Type::U16,
    "u32" => Type::U32,
    "u64" => Type::U64,
    "i8" => Type::I8,
    "i16" => Type::I16,
    "i32" => Type::I32,
    "i64" => Type::I64,
    "f8" => Type::F8,
    "f16" => Type::F16,
    "f32" => Type::F32,
    "f64" => Type::F64,
    "bool" => Type::Bool,
    "String" => Type::String,
    "Vec" "<" <t:Type> ">" => Type::Vector(t),
    "Array" <t:Type> "[" <l:IntLiteral> "]"=> Type::Array(t, l),
};


// String literals with escape support (e.g., "hello\nworld")
StringLiteral: String = {
    r#""([^"\\\r\n]|\\.)*""# => |s| {
        let inner = &s[1..s.len()-1]; // Strip surrounding quotes
        unescape_str(inner)
    }
};

// Integer literals (e.g., 0, 42)
IntLiteral: i64 = {
    r"0|[1-9][0-9]*" => |s| s.parse().unwrap()
};

// Floating-point literals (e.g., 3.14, 0.001)
FloatLiteral: f64 = {
    r"[0-9]+\.[0-9]+" => |s| s.parse().unwrap()
};

// Character literals with escape support (e.g., 'a', '\n')
CharLiteral: char = {
    r#"'([^'\\\r\n]|\\.)'"# => |s| {
        let inner = &s[1..s.len()-1]; // Strip surrounding quotes
        unescape_char(inner)
    }
};

// Boolean literals (true / false)
BoolLiteral: bool = {
    "true" => |_| true,
    "false" => |_| false,
};

// Identifiers (variable and function names)
ID: String = {
    r"[a-zA-Z_][a-zA-Z0-9_]*" => |s| s.to_string()
};
